{
  "root": true,
  "env": {
    "browser": true,
    "es6": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/eslint-recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:import/recommended",
    "plugin:import/electron",
    "plugin:import/typescript"
  ],
  "parser": "@typescript-eslint/parser",
  "overrides": [
    {
      "files": [
        "src/renderer/**/*.{ts,tsx}"
      ],
      "rules": {
        "no-constant-condition": [
          "error",
          {
            "checkLoops": false
          }
        ]
      }
    },
    {
      "files": [
        "src/renderer/components/ui/**/*.{ts,tsx}",
        "src/renderer/components/layout/**/*.{ts,tsx}"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/pages/**",
                  "**/features/**",
                  "**/platform/**",
                  "react-router-dom"
                ],
                "message": "UI primitives must receive data and actions from their caller."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/renderer/features/book-content/**/*.{ts,tsx}",
        "src/renderer/features/book-presentation/**/*.{ts,tsx}"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "**/pages/**"
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/shared/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/main/**",
                  "**/renderer/**",
                  "electron",
                  "better-sqlite3",
                  "langchain",
                  "@langchain/**",
                  "node:*"
                ],
                "message": "Shared contracts must remain independent of backend and UI implementations."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/main/story/application/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "Inject desktop ports from the bootstrap layer."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/main/agent/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/story/**",
                  "**/desktop/**",
                  "**/bootstrap/**",
                  "**/shared/contracts/**",
                  "electron",
                  "electron/*"
                ],
                "message": "The generic engine depends only on its own modules and shared/engine contracts."
              }
            ]
          }
        ]
      }
    }
  ]
}
